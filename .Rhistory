library(tidyquant)
library(dplyr)
library(tidyr)
library(lubridate)
library(ggplot2)
activo <- "MXN=X"
fecha_val <- as.Date("2024-09-09")
ventana <- 250
precios <- tq_get(activo,
get = "stock.prices",
to  = fecha_val) %>%
arrange(date) %>%
tail(ventana)
rendimientos <- precios %>%
mutate(r = log(adjusted / lag(adjusted))) %>%
drop_na()
inversion <- 100000
niveles_conf <- c(0.95, 0.98)
horizontes <- 1:5
calc_var <- function(x, alpha) {
quantile(x, 1 - alpha, na.rm = TRUE)
}
calc_cvar <- function(x, alpha) {
var <- calc_var(x, alpha)
mean(x[x <= var], na.rm = TRUE)
}
resultados_pct <- expand_grid(alpha = niveles_conf,
h = horizontes) %>%
rowwise() %>%
mutate(
VaR = calc_var(rendimientos$r, alpha) * sqrt(h),
CVaR = calc_cvar(rendimientos$r, alpha) * sqrt(h)
)
resultados_monet <- resultados_pct %>%
mutate(
VaR_MXN = -VaR * inversion,
CVaR_MXN = -CVaR * inversion
)
rendimientos_pl <- rendimientos %>%
mutate(PL = inversion * r)
alpha_95 <- 0.95
alpha_98 <- 0.98
ggplot(rendimientos, aes(x = r)) +
geom_histogram(bins = 40, fill = "lightblue", color = "black") +
geom_vline(xintercept = calc_var(rendimientos$r, alpha_95), linetype = "dashed") +
geom_vline(xintercept = calc_var(rendimientos$r, alpha_98), linetype = "dashed") +
labs(title = "Distribución de rendimientos USD/MXN",
x = "Rendimiento",
y = "Frecuencia")
